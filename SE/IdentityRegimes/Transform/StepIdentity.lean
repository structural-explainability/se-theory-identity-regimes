module

public import SE.Persistence.Relation.Equivalence
public import SE.IdentityRegimes.Transform.Effect

set_option autoImplicit false

/-!
File: SE/IdentityRegimes/Transform/StepIdentity.lean

Purpose:
Step-level generated identity, collapse, separation, and stability.

The generated relation of a basis on a domain `D` is the equivalence closure of
the admissible steps inside `D` that preserve the basis invariant.
It is built from steps, not from family verdicts.
A family with verdict `mix` therefore keeps its preserving steps, and
enlarging `D` only adds edges.

Main results:
  - `stepIdentity_sound`: the invariant is constant on generated classes.
  - `collapse_iff_stepAgree`: two bases generate the same relation on `D`
    exactly when they agree on which steps in `D` preserve.
  - `separation_of_step`: a single step that one basis preserves and the other
    changes separates the generated relations.
  - `not_collapse_mono`: separation persists on every larger domain.
  - `exists_instance_of_split`: a split between verdicts supplies such a step.
  - `identityRel_le_stepIdentity`, `stepIdentity_eq_identityRel_of_uniform`:
    relation to the family-level identity relation of `SE.Persistence`.

Scope:
These results hold for bases given as invariants. They say nothing about bases
that are not functions of presentations.
-/

namespace SE.IdentityRegimes

@[expose] public section

open SE.Persistence

variable {T C ι ν V V' : Type}

namespace EffectModel

variable {get : ι → C → ν} (M : EffectModel T get)

-- RR.DEFINES: SEIR.DEF.STEP_REL
/-- Steps inside `D` whose endpoints have equal invariants. -/
def StepRel (b : InvariantBasis get V) (D : C → Prop) : C → C → Prop :=
  fun x y => D x ∧ D y ∧ ∃ f, M.step f x y ∧ b.inv x = b.inv y

-- RR.DEFINES: SEIR.DEF.STEP_IDENTITY
/-- The identity relation generated by the preserving steps inside `D`. -/
def StepIdentity (b : InvariantBasis get V) (D : C → Prop) : C → C → Prop :=
  Generated (M.StepRel b D)

-- RR.DEFINES: SEIR.DEF.STEP_COLLAPSE
/-- Two bases generate the same identity relation on `D`. -/
def Collapse (b : InvariantBasis get V) (b' : InvariantBasis get V')
    (D : C → Prop) : Prop :=
  ∀ x y, M.StepIdentity b D x y ↔ M.StepIdentity b' D x y

-- RR.DEFINES: SEIR.DEF.STEP_AGREE
/-- Every step inside `D` is preserved by both bases or changed by both. -/
def StepAgree (b : InvariantBasis get V) (b' : InvariantBasis get V')
    (D : C → Prop) : Prop :=
  ∀ f x y, D x → D y → M.step f x y →
    (b.inv x = b.inv y ↔ b'.inv x = b'.inv y)

variable {M} {b : InvariantBasis get V} {b' : InvariantBasis get V'}
  {D D' : C → Prop}

-- RR.DEFINES: SEIR.THM.STEP_IDENTITY_SOUND
/-- The invariant is constant on generated classes. -/
theorem stepIdentity_sound {x y : C} (h : M.StepIdentity b D x y) :
    b.inv x = b.inv y :=
  Generated.le_of_equivalence (r := M.StepRel b D)
    (s := fun a c => b.inv a = b.inv c)
    ⟨fun _ => rfl, fun h => h.symm, fun h1 h2 => h1.trans h2⟩
    (fun _ _ hac => by
      obtain ⟨_, _, _, _, he⟩ := hac
      exact he) h

-- RR.DEFINES: SEIR.THM.COLLAPSE_IFF_STEP_AGREE
/-- Collapse holds exactly when the bases agree on every step in `D`. -/
theorem collapse_iff_stepAgree :
    M.Collapse b b' D ↔ M.StepAgree b b' D := by
  constructor
  · intro hc f x y hx hy hs
    constructor
    · intro hp
      have g : M.StepIdentity b D x y := Generated.rel ⟨hx, hy, f, hs, hp⟩
      exact stepIdentity_sound ((hc x y).1 g)
    · intro hp
      have g : M.StepIdentity b' D x y := Generated.rel ⟨hx, hy, f, hs, hp⟩
      exact stepIdentity_sound ((hc x y).2 g)
  · intro ha x y
    constructor
    · intro g
      refine Generated.mono ?_ g
      intro a c hac
      obtain ⟨ha1, hc1, f, hs, hp⟩ := hac
      exact ⟨ha1, hc1, f, hs, (ha f a c ha1 hc1 hs).1 hp⟩
    · intro g
      refine Generated.mono ?_ g
      intro a c hac
      obtain ⟨ha1, hc1, f, hs, hp⟩ := hac
      exact ⟨ha1, hc1, f, hs, (ha f a c ha1 hc1 hs).2 hp⟩

-- RR.DEFINES: SEIR.THM.SEPARATION_OF_STEP
/-- A step in `D` that `b` preserves and `b'` changes separates the generated
relations: its endpoints are related by `b` and not by `b'`. -/
theorem separation_of_step {f : T} {x y : C} (hx : D x) (hy : D y)
    (hs : M.step f x y) (hp : b.inv x = b.inv y) (hb : b'.inv x ≠ b'.inv y) :
    M.StepIdentity b D x y ∧ ¬ M.StepIdentity b' D x y :=
  ⟨Generated.rel ⟨hx, hy, f, hs, hp⟩, fun h => hb (stepIdentity_sound h)⟩

/-- A separating step rules out collapse. -/
theorem not_collapse_of_step {f : T} {x y : C} (hx : D x) (hy : D y)
    (hs : M.step f x y) (hp : b.inv x = b.inv y) (hb : b'.inv x ≠ b'.inv y) :
    ¬ M.Collapse b b' D := by
  intro hc
  exact (separation_of_step hx hy hs hp hb).2 ((hc x y).1
    (separation_of_step hx hy hs hp hb).1)

-- RR.DEFINES: SEIR.THM.NOT_COLLAPSE_MONO
/-- Separation persists on every larger domain. -/
theorem not_collapse_mono (hn : ¬ M.Collapse b b' D)
    (hD : ∀ x, D x → D' x) : ¬ M.Collapse b b' D' := by
  intro hc
  apply hn
  rw [collapse_iff_stepAgree] at hc ⊢
  intro f x y hx hy hs
  exact hc f x y (hD x hx) (hD y hy) hs

-- RR.DEFINES: SEIR.THM.COLLAPSE_OF_NO_STEP
/-- Bases collapse on a domain that contains no step. -/
theorem collapse_of_no_step
    (h : ∀ f x y, D x → D y → ¬ M.step f x y) : M.Collapse b b' D := by
  rw [collapse_iff_stepAgree]
  intro f x y hx hy hs
  exact absurd hs (h f x y hx hy)

-- RR.DEFINES: SEIR.THM.EXISTS_INSTANCE_OF_SPLIT
/-- If `f` never changes the invariant of `b` but sometimes changes that of
`b'`, some effective instance of `f` is preserved by `b` and changed by `b'`. -/
theorem exists_instance_of_split {f : T}
    (hnb : M.NoneBreak b f) (hbrk : ¬ M.NoneBreak b' f) :
    ∃ x y, M.Effective f x y ∧ b.inv x = b.inv y ∧ b'.inv x ≠ b'.inv y := by
  apply Classical.byContradiction
  intro hno
  apply hbrk
  intro x y hxy
  apply Classical.byContradiction
  intro hne
  exact hno ⟨x, y, hxy, hnb x y hxy, hne⟩

-- RR.DEFINES: SEIR.THM.NOT_COLLAPSE_OF_SPLIT
/-- If `f` never changes the invariant of `b`, any domain that contains an
effective instance of `f` changed by `b'` separates the bases. -/
theorem not_collapse_of_split {f : T}
    (hnb : M.NoneBreak b f)
    (hD : ∃ x y, D x ∧ D y ∧ M.Effective f x y ∧ b'.inv x ≠ b'.inv y) :
    ¬ M.Collapse b b' D := by
  obtain ⟨x, y, hx, hy, hxy, hne⟩ := hD
  exact not_collapse_of_step hx hy hxy.1 (hnb x y hxy) hne

/-- The dynamics underlying an effect model. -/
def toDynamics : Dynamics T C :=
  ⟨M.step⟩

-- RR.DEFINES: SEIR.THM.IDENTITY_REL_LE_STEP_IDENTITY
/-- The family-level identity relation is contained in the step-level one,
for any classification that marks as preserving only families all of whose steps
preserve the invariant. -/
theorem identityRel_le_stepIdentity (c : Classification T)
    (hc : ∀ f, c.IsPrs f → ∀ x y, M.step f x y → b.inv x = b.inv y)
    {x y : C} (h : c.identityRel M.toDynamics x y) :
    M.StepIdentity b (fun _ => True) x y := by
  refine Generated.mono ?_ h
  intro a e ⟨f, hf, hs⟩
  exact ⟨trivial, trivial, f, hs, hc f hf a e hs⟩

-- RR.DEFINES: SEIR.THM.STEP_IDENTITY_EQ_IDENTITY_REL_OF_UNIFORM
/-- When every family either preserves all its steps or changes all of them,
and `c` marks exactly the preserving families, the step-level and
family-level identity relations coincide. -/
theorem stepIdentity_eq_identityRel_of_uniform (c : Classification T)
    (hc : ∀ f, c.IsPrs f ↔ ∀ x y, M.step f x y → b.inv x = b.inv y)
    (huni : ∀ f, (∀ x y, M.step f x y → b.inv x = b.inv y) ∨
      (∀ x y, M.step f x y → b.inv x ≠ b.inv y)) :
    M.StepIdentity b (fun _ => True) = c.identityRel M.toDynamics := by
  funext x y
  apply propext
  constructor
  · intro h
    refine Generated.mono ?_ h
    intro a e ⟨_, _, f, hs, hp⟩
    refine ⟨f, ?_, hs⟩
    rcases huni f with hall | hnone
    · exact (hc f).2 hall
    · exact absurd hp (hnone a e hs)
  · exact identityRel_le_stepIdentity c (fun f hf => (hc f).1 hf)

end EffectModel

end

end SE.IdentityRegimes
